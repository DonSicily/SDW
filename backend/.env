PORT=5000
NODE_ENV=development

# MongoDB connection string
DB_URL=mongodb+srv://your_username:your_password@cluster.mongodb.net/taxi_db

# MUST be a long random string (32+ chars). Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated list of allowed web origins for CORS / Socket.IO.
# Use * only for local development. In production this MUST be an explicit
# allow-list (e.g. https://admin.yourdomain.com) — the server will refuse to
# start if CORS_ORIGINS is missing or set to * when NODE_ENV=production.
CORS_ORIGINS=*

# Redis (optional but recommended). Without it, sockets/geo fall back to in-memory.
REDIS_URL=redis://127.0.0.1:6379

# Routing (P2): prefer a paid/self-hosted provider in production.
# ROUTING_PROVIDER=mapbox|google|osrm|haversine  (auto-detect if unset)
ROUTING_PROVIDER=
# Mapbox Directions — https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=
# Google Directions — https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=
# Self-hosted OSRM base URL (e.g. http://osrm:5000) — required for ROUTING_PROVIDER=osrm
OSRM_BASE_URL=
# Legacy alias used as Mapbox token when MAPBOX_ACCESS_TOKEN is empty
MAP_API_KEY=your_openstreetmap_or_mapbox_key

# Termii SMS OTP — https://developers.termii.com
# Without TERMII_API_KEY, OTPs are logged to the server console (dev only).
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=TaxiApp

RAILWAY_URL=https://your-railway-app.up.railway.app

# Paystack keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Long random string required to create the first admin account
ADMIN_SETUP_KEY=choose_a_long_random_string_for_creating_the_first_admin
# After the first admin exists, further admin registration is blocked unless this is true
ALLOW_ADMIN_SETUP=false

# Pending ride auto-cancel timeout (ms). Default 180000 = 3 minutes.
RIDE_PENDING_TIMEOUT_MS=180000

# Per-phone OTP send limits (window in seconds, max sends per phone)
OTP_SEND_WINDOW_SEC=900
OTP_SEND_MAX=5
